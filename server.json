{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.NBhey/figma-vault",
  "title": "figma-vault",
  "description": "Figma designs pulled once into a local vault; AI agents read them offline with no rate limits",
  "repository": {
    "url": "https://github.com/NBhey/figma-vault",
    "source": "github"
  },
  "websiteUrl": "https://github.com/NBhey/figma-vault#readme",
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "figma-vault",
      "version": "0.1.4",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
