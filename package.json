{
  "name": "figma-vault",
  "version": "0.1.0",
  "description": "Pull a Figma frame once, then let Claude Code, Codex and other MCP agents read it offline with no Figma rate limits",
  "author": "NBhey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBhey/figma-vault.git"
  },
  "homepage": "https://github.com/NBhey/figma-vault#readme",
  "bugs": {
    "url": "https://github.com/NBhey/figma-vault/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "figma-vault": "dist/cli/index.js"
  },
  "scripts": {
    "pull": "node --env-file-if-exists=.env --import tsx src/pull/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:example": "tsx src/mcp/index.ts --vault vault/example",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev": "node scripts/serve.mjs",
    "prepare": "npm run build",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.map",
    "vault/example",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "codex",
    "design-to-code",
    "offline",
    "rate-limit"
  ],
  "license": "MIT"
}
